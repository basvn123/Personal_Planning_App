# Pooled Postgres connection for the app (Neon/Supabase inject this for you)
DATABASE_URL=
# Direct connection (port 5432) for running migrations
DATABASE_URL_UNPOOLED=
# One-time owner sign-in until the owner sets an email and password
APP_PASSCODE=
# 32+ random characters used to sign the session cookie
SESSION_SECRET=
# Vercel Cron sends this as a bearer token to /api/cron/materialize
CRON_SECRET=
# Vercel Blob store for uploaded files (Storage, Blob). Leave empty locally to use ./.uploads
BLOB_READ_WRITE_TOKEN=
# Newer Blob stores inject these instead of a token (uploads then go through OIDC + presigned URLs)
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
